          "1": {
            "Name": "item_detail_id",
            "Index": -1,
            "NameInSource": "item_detail_id",
            "Alias": "item_detail_id",
            "Type": "System.Int32"
          }
        },
        "NameInSource": "Connection",
        "SqlCommand": "SELECT item_description.description,item_description.item_detail_id FROM item_description LEFT JOIN sales_invoice_item ON(item_description.item_detail_id=sales_invoice_item.id AND item_description.invoice_type='SI') WHERE item_description.deleted_at='0000-00-00 00:00:00' AND sales_invoice_item.sales_invoice_id={id}"
      }
    },
